{
    "manifest": 1,
    "code": "good",
    "name": "Fixture Good",
    "version": "0.1.0",
    "description": "A valid theme the tests render through.",
    "requires": { "teme": "^0.1" },
    "templates": { "page": { "full-width": "Full width" } },
    "navigations": { "primary": "Header", "footer": "Footer" },
    "regions": { "after-content": { "label": "After the article", "cards": ["callout", "button"], "max": 5 } },
    "settings": [
        { "key": "color_scheme", "type": "select", "label": "Colour scheme", "fieldset": "site", "options": { "auto": "Auto", "light": "Light", "dark": "Dark" }, "default": "auto" },
        { "key": "featured_image_style", "type": "select", "label": "Featured image", "fieldset": "content", "options": { "wide": "Wide", "full": "Full width", "content": "Text width", "hidden": "Hidden" }, "default": "wide" },
        { "key": "show_related", "type": "boolean", "label": "Show related posts", "fieldset": "content", "default": true },
        { "key": "latest_header", "type": "select", "label": "Latest posts header", "fieldset": "latest", "options": { "lead": "Lead story", "none": "None" }, "default": "lead" },
        { "key": "feed_layout", "type": "select", "label": "Feed layout", "fieldset": "latest", "options": { "list": "List", "grid": "Grid" }, "default": "list" },
        { "key": "feed_images", "type": "boolean", "label": "Images in the list", "fieldset": "latest", "default": true, "visible_when": { "feed_layout": "list" } }
    ],
    "assets": { "manifest": "public/build/manifest.json", "entries": ["assets/css/theme.css"] },
    "composers": ["Tests\\Fixtures\\Themes\\Good\\Greets"],
    "images": { "content": "(min-width: 720px) 680px, 100vw" },
    "fonts": [{ "family": "Newsreader", "file": "fonts/newsreader.woff2", "weight": "400 700", "style": "normal", "preload": true }],
    "tokens": { "base": "#ffffff", "accent": "#b3261e" },
    "tokens_dark": { "base": "#141413" },
    "cards": { "replaces": ["callout"] },
    "per_page": 10
}
