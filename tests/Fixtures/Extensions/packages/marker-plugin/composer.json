{
    "name": "fixtures/marker-plugin",
    "description": "A Composer plugin that writes a marker file if it ever runs.",
    "type": "composer-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "composer-plugin-api": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Fixtures\\MarkerPlugin\\": "src/"
        }
    },
    "extra": {
        "class": "Fixtures\\MarkerPlugin\\Marker"
    }
}
