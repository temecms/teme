        "pageType": "<div class=\"grid gap-2\"><label data-slot=\"label\" class=\"text-small font-medium text-ink-2 select-none group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50\" for=\"editor-page-type\">Page type</label><button type=\"button\" role=\"combobox\" aria-expanded=\"false\" aria-autocomplete=\"none\" dir=\"ltr\" data-state=\"closed\" data-slot=\"select-trigger\" data-size=\"default\" class=\"relative flex w-fit items-center justify-between gap-2 rounded-md border border-edge bg-surface ps-3 pe-8 text-body text-ink whitespace-nowrap transition-[border-color] duration-(--dur-1) ease-(--ease) outline-none focus-visible:border-transparent focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-0 focus-visible:outline-ring aria-invalid:border-danger disabled:cursor-not-allowed disabled:bg-surface-2 disabled:text-ink-3 data-[placeholder]:text-ink-3 data-[size=default]:h-(--ctl-h) data-[size=sm]:h-(--ctl-h-sm) *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center *:data-[slot=select-value]:gap-2 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4\" id=\"editor-page-type\" aria-describedby=\"editor-page-type-hint\"><span data-slot=\"select-value\" style=\"pointer-events: none;\">About page</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down pointer-events-none absolute end-3 size-4 text-ink-2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><p id=\"editor-page-type-hint\" class=\"text-ink-2 text-caption\">What search engines are told this page is. Empty uses the default for its type.</p></div>",
