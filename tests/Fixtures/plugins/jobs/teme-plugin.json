{
    "manifest": 1,
    "name": "tests/jobs",
    "code": "jobs",
    "label": "Jobs",
    "description": "A plugin the tests enable, which declares background jobs.",
    "version": "1.0.0",
    "requires": { "teme": "^0.5" },
    "plugin": "Tests\\Fixtures\\Plugins\\Jobs\\JobsPlugin",
    "capabilities": ["jobs", "http"],
    "hosts": ["api.example.com"],
    "jobs": [
        { "key": "write-line", "label": "Write a line", "tries": 2, "backoff": [1, 2] },
        { "key": "quiet-write", "label": "Quiet write", "tries": 1, "backoff": [1] },
        { "key": "progress-write", "label": "Progress write", "tries": 1, "backoff": [1] },
        { "key": "long-call", "label": "Long outbound call", "long": true, "tries": 1, "backoff": [1] },
        { "key": "throw", "label": "Throw once", "tries": 2, "backoff": [1] },
        { "key": "fail-for-good", "label": "Fail for good", "tries": 3, "backoff": [1, 2, 3] },
        { "key": "summarise", "label": "Summarise", "tries": 1, "backoff": [1] },
        { "key": "list-permissions", "label": "List permissions", "tries": 1, "backoff": [1] },
        { "key": "nest-queue", "label": "Nest a queue", "tries": 1, "backoff": [1] }
    ],
    "schedules": [
        { "job": "write-line", "every": "hour" }
    ],
    "owns": { "tables": ["jobs_lines"] },
    "contributes": {
        "actions": [
            { "id": "summarise-now", "label": "Summarise now", "description": "Runs the summarise job from a settings action.", "job": "summarise" }
        ],
        "permissions": [
            {
                "id": "manage-lines",
                "label": "Manage lines",
                "description": "Write job lines.",
                "roles": ["editor"]
            },
            {
                "id": "view-all",
                "label": "View every line",
                "description": "See every line.",
                "roles": []
            }
        ]
    }
}
