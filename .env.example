APP_NAME=Teme
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=teme
DB_USERNAME=teme
DB_PASSWORD=teme
DB_BENCH_DATABASE=teme_bench

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=media
MEDIA_ORIGINALS_DISK=media-originals
MEDIA_IMAGE_DRIVER=gd
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# The full-page cache (slice 1.7) is on everywhere but APP_ENV=local, so a
# theme's Blade changes show at once on a developer's machine. Set
# PAGE_CACHE_ENABLED to true or false to decide whatever the environment.
# It stores pages for APP_URL's host only, in a folder the web server, the
# queue worker and the scheduler share (PAGE_CACHE_PATH, storage/page-cache
# by default, never on a container's own tmpfs). A page lives an
# hour at most (PAGE_CACHE_LIFETIME, in seconds); a change purges it sooner.
# With several servers, or no folder they all share, keep pages in Valkey
# instead: PAGE_CACHE_DRIVER=redis, with the phpredis extension and the
# REDIS_* settings below. The pages keep a database of their own
# (REDIS_PAGE_CACHE_DB, 2), and each page's lock beside it.
# On one server, the web server itself can serve stored pages as plain
# files, with no PHP at all: PAGE_CACHE_DRIVER=static, with the settings
# in docker/ for nginx or Caddy, then php artisan teme:cache:check-static.
# The files go in PAGE_CACHE_STATIC_PATH (storage/page-cache/static).
# With Cloudflare in front, name it (PAGE_CACHE_CDN=cloudflare) and give it
# the zone's ID and an API token whose one permission is Zone > Cache Purge:
# each page then tells Cloudflare what it shows and how long it may keep
# it, and every change is purged there too, on the queue.
# After a change, the queue worker draws up to 20 of the pages it touched
# again before anyone asks (PAGE_CACHE_WARM=false turns it off;
# PAGE_CACHE_WARM_PAGES changes how many).
# PAGE_CACHE_ENABLED=
# PAGE_CACHE_PATH=
# PAGE_CACHE_LIFETIME=
# PAGE_CACHE_DRIVER=
# PAGE_CACHE_STATIC_PATH=
# PAGE_CACHE_CDN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# PAGE_CACHE_WARM=
# PAGE_CACHE_WARM_PAGES=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The shortest time, in microseconds, a sign-in or password-reset endpoint may
# take to answer. Twice the measured Argon2id time (507 ms on the dev machine),
# rounded up to 100 ms. Re-measure on the production host.
AUTH_TIMEBOX_DURATION=1100000

# The edge (I-380). TRUSTED_PROXIES lists the proxies whose X-Forwarded-*
# headers are believed: addresses and ranges, comma-separated, and two
# names, private (the ranges Docker networks use) and cloudflare
# (Cloudflare's published ranges). Unset, production trusts private and
# nothing else trusts any proxy; set, even empty, it means exactly what it
# says. Behind Cloudflare and Traefik write private,cloudflare, and have
# Traefik trust Cloudflare too. "*" and a range of /0 are refused at boot.
# TRUSTED_PROXIES=
# In production at an https APP_URL, every https answer carries
# Strict-Transport-Security with TEME_HSTS's value, a year by default.
# Empty sends none, where a proxy in front sends its own. There, too, the
# session cookie is Secure and named __Host-..., every other cookie is
# Secure, and SESSION_DRIVER must stay database.
# TEME_HSTS=max-age=31536000
# A secret can come from a file instead: name the file in the same variable
# with _FILE added, such as DB_PASSWORD_FILE=/run/secrets/db_password, and
# leave the variable itself unset. APP_KEY, APP_PREVIOUS_KEYS, DB_PASSWORD,
# REDIS_PASSWORD, MAIL_PASSWORD, CLOUDFLARE_API_TOKEN, the TEME_AI_*_KEY
# keys, TEME_BACKUP_MACHINE_KEY and TEME_VERIFY_DB_PASSWORD can.

# A host that forbids code added from the admin sets this to true: no page
# draws Settings › Site code's entries, and nobody can change them. Clear
# the page cache after changing it: php artisan teme:cache:clear.
# TEME_DISALLOW_SITE_CODE=false
# TEME_PUBLIC_CSP=report-only

# A site that changes its content types only by file sets this to true:
# nobody can make, change or delete one in the admin, and
# php artisan teme:types:import brings them from where they are made.
# TEME_TYPES_LOCKED=false

# A host that forbids AI sets this to off: no AI surface shows anywhere, and
# a request already waiting ends unanswered. Unset means on; anything but a
# yes (on, true, 1, yes) means off. Run php artisan config:cache after
# changing it where config is cached.
# TEME_AI=on

# An AI service's key, set here instead of in Settings › AI. Set, it
# replaces the stored key and can't be changed there.
# TEME_AI_ANTHROPIC_KEY=
# TEME_AI_OPENAI_KEY=
# TEME_AI_DEEPSEEK_KEY=
# TEME_AI_OPENROUTER_KEY=

# Backups (I-2400): where restic and PostgreSQL's command-line tools are,
# when they aren't on the PATH. On Windows, quote paths with single quotes.
# TEME_RESTIC_BINARY=restic
# TEME_POSTGRES_BINDIR=
# The key Teme's scheduled backups use, when the server supplies it.
# TEME_BACKUP_MACHINE_KEY=
# restic's cache folder; empty runs restic without one.
# TEME_RESTIC_CACHE=

# The weekly test restore's spare database (I-2406): made at installation,
# owned by Teme's database account, emptied before and after each test.
# Its name must end in _verify. Host, port, user and password default to DB_*.
# TEME_VERIFY_DATABASE=teme_verify
# TEME_VERIFY_DB_HOST=
# TEME_VERIFY_DB_PORT=
# TEME_VERIFY_DB_USERNAME=
# TEME_VERIFY_DB_PASSWORD=

# Local development only: folders of plugins and themes you are building,
# separated by commas, loaded beside Composer's packages
# (docs/guides/developers/start/development-site.md).
# TEME_PLUGIN_PATHS=../my-plugin,../my-other-plugin
# TEME_THEME_PATHS=../my-theme
