{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "teme/teme",
    "type": "project",
    "description": "Teme, a content management system built on Laravel and PostgreSQL.",
    "keywords": ["cms", "content management", "publishing", "laravel", "postgresql"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "composer/semver": "^3.5",
        "gapple/structured-fields": "2.3.3",
        "inertiajs/inertia-laravel": "^3.3",
        "intervention/image": "^4",
        "laravel/ai": "^1.2",
        "laravel/fortify": "^1.39",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.21",
        "sebastian/diff": "^9.0",
        "spatie/laravel-permission": "^8.3",
        "teme/contracts": "*",
        "teme/theme-default": "@dev",
        "ueberdosis/tiptap-php": "^2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/teme-contracts",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "themes/*",
            "options": { "symlink": true }
        }
    ],
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel-lang/lang": "15.38.0",
        "laravel/boost": "*",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Teme\\Testing\\": "packages/teme-testing/src/",
            "Tests\\Fixtures\\Themes\\Good\\": "tests/Fixtures/themes/good/composers/",
            "Tests\\Fixtures\\Themes\\Greedy\\": "tests/Fixtures/themes/greedy/composers/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "check": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --no-progress",
            "npm run types:check",
            "npm run check",
            "npm run build:themes",
            "@php artisan test --testsuite=Architecture",
            "@php artisan test --parallel --testsuite=Unit,Feature"
        ],
        "check:browser": [
            "npm run build",
            "npm run build:themes",
            "@php artisan teme:themes:link",
            "@php artisan test --testsuite=Browser"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "boost": [
            "@php artisan boost:update --ansi"
        ],
        "check:plugins": [
            "@php artisan test --compact --testsuite=Plugins",
            "@php vendor/bin/phpstan analyse -c phpstan-plugins.neon --memory-limit=2G --no-progress"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "process-timeout": 0
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
