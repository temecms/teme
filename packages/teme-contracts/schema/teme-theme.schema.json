{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:teme:theme-manifest:1",
    "title": "Teme theme manifest, version 1",
    "description": "teme-theme.json.",
    "$comment": "@since 0.4.0",
    "type": "object",
    "required": [
        "manifest",
        "code",
        "name",
        "version",
        "description",
        "requires"
    ],
    "not": {
        "anyOf": [{ "required": ["parent"] }, { "required": ["extends"] }]
    },
    "additionalProperties": true,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Optional. The path to this file, for an editor's help; Teme reads nothing from it."
        },
        "manifest": {
            "type": "integer",
            "const": 1,
            "description": "The manifest's version. Always 1."
        },
        "code": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$",
            "description": "The theme's code: 2 to 40 lower-case letters, digits and hyphens, starting with a letter or digit. Unique among themes; for a theme in a plain folder, the folder's name."
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "$comment": "Teme refuses a value of white space only (it trims first); the pattern says so for ASCII white space, which is all PHP's trim() removes, and a schema can't say more.",
            "description": "The theme's name, as people see it."
        },
        "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "$comment": "Teme refuses a value of white space only (it trims first); the pattern says so for ASCII white space, which is all PHP's trim() removes, and a schema can't say more.",
            "description": "The theme's own version."
        },
        "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "$comment": "Teme refuses a value of white space only (it trims first); the pattern says so for ASCII white space, which is all PHP's trim() removes, and a schema can't say more.",
            "description": "What the theme is for, in a sentence."
        },
        "requires": {
            "type": "object",
            "required": ["teme"],
            "description": "What the theme needs.",
            "properties": {
                "teme": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "$comment": "Teme refuses a value of white space only (it trims first); the pattern says so for ASCII white space, which is all PHP's trim() removes, and a schema can't say more.",
                    "description": "A Composer version constraint on Teme's own version, such as ^1.0."
                }
            }
        },
        "author": {
            "type": "string",
            "description": "Shown to people only; Teme reads nothing from it."
        },
        "author_url": {
            "type": "string",
            "format": "uri",
            "description": "The author’s website."
        },
        "homepage": {
            "type": "string",
            "format": "uri",
            "description": "Where to read about the theme."
        },
        "license": {
            "type": "string",
            "description": "Shown to people only; Teme reads nothing from it."
        },
        "templates": {
            "type": "object",
            "description": "Content type, then template slug, then label. Every slug but default needs views/templates/single-{type}-{slug}.blade.php: only the theme's files can say whether it exists.",
            "propertyNames": { "pattern": "^[a-z0-9-]+$" },
            "additionalProperties": {
                "type": "object",
                "propertyNames": { "pattern": "^[a-z0-9-]+$" },
                "additionalProperties": { "type": "string", "minLength": 1 }
            }
        },
        "navigations": {
            "type": "object",
            "description": "The places the theme draws a menu: slot, then label.",
            "propertyNames": { "pattern": "^[a-z0-9-]+$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "regions": {
            "type": "object",
            "description": "The places the theme puts the site's own content: slug, then label, group, cards, max, size and minWidth. A region takes every card unless its cards name the ones it takes: Teme's cards by name, a plugin's as code:id. Every core card named must be a registered card: only Teme's registry can say which are.",
            "propertyNames": { "pattern": "^[a-z0-9-]+$" },
            "additionalProperties": {
                "type": "object",
                "required": ["label"],
                "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "cards": {
                        "description": "\"*\" or absent for every card; else the cards the region takes.",
                        "oneOf": [
                            { "const": "*" },
                            { "type": "array", "items": { "type": "string" } }
                        ]
                    },
                    "group": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40,
                        "description": "The heading Content › Regions lists the region under, such as \"Ad placements\"; regions without one are listed under \"Regions\"."
                    },
                    "size": {
                        "type": "string",
                        "pattern": "^[1-9]\\d{1,4}x[1-9]\\d{1,4}$",
                        "description": "The region's size in pixels, width x height, told to its cards; advice only."
                    },
                    "max": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50,
                        "description": "How many cards the region holds; 50 when absent."
                    },
                    "minWidth": {
                        "type": "integer",
                        "minimum": 200,
                        "maximum": 4000,
                        "description": "The narrowest viewport, in pixels, the region is drawn at. Below it nothing of the region is loaded, scripts included; the page carries a placeholder that core's script fills when the viewport reaches this width."
                    }
                }
            }
        },
        "settings": {
            "type": "array",
            "description": "The theme's own settings. A select needs options, and its default is one of them; a boolean's default is true or false; a visible_when names only settings declared before it. A number may give min, max, step and unit; a links default is a list of label and address, at most 12; group names a foldable section inside the fieldset.",
            "items": {
                "type": "object",
                "required": ["key", "type", "label", "fieldset", "default"],
                "properties": {
                    "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{1,40}$",
                        "description": "2 to 41 lower-case letters, digits and underscores, starting with a letter; never starting with nav_."
                    },
                    "type": {
                        "type": "string",
                        "enum": ["select", "boolean", "text", "color", "number", "image", "menu", "links", "url", "textarea"]
                    },
                    "label": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "fieldset": {
                        "type": "string",
                        "enum": ["site", "latest", "content", "archive"]
                    },
                    "group": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A titled foldable section inside the fieldset. Settings without a group stay at the top."
                    },
                    "options": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string",
                            "minLength": 1
                        },
                        "description": "Stored value, then label. Only a select takes options."
                    },
                    "min": {
                        "type": "integer",
                        "description": "A number setting's least value."
                    },
                    "max": {
                        "type": "integer",
                        "description": "A number setting's greatest value."
                    },
                    "step": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "A number setting's step on the form."
                    },
                    "unit": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A number setting's unit, shown beside its field."
                    },
                    "default": {
                        "description": "A select's default is one of its options; a boolean's is true or false; a text's or textarea's is text; a menu's or image's is \"\"; a colour's is an empty string or #rrggbb; a number's is a whole number in its bounds; a url's is empty or http(s); a links' is a list of {label, address}."
                    },
                    "visible_when": {
                        "type": "object",
                        "description": "Earlier setting keys, each with a value or a list of values."
                    }
                }
            }
        },
        "assets": {
            "type": "object",
            "required": ["manifest"],
            "description": "The theme's Vite build.",
            "properties": {
                "manifest": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A relative path inside the theme."
                },
                "entries": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "description": "The entries the theme's Vite build names."
                }
            }
        },
        "title_separator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3,
            "description": "Between the parts of a page's title; – when absent."
        },
        "layout": {
            "type": "object",
            "required": ["content", "wide"],
            "description": "The content, wide and full widths in pixels.",
            "properties": {
                "content": { "type": "integer", "minimum": 1 },
                "wide": { "type": "integer", "minimum": 1 },
                "full": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "Null for the whole viewport."
                }
            }
        },
        "images": {
            "type": "object",
            "required": ["content"],
            "description": "Image context, then its sizes value: lengths in px, vw or rem, every entry but the last after a media condition in parentheses.",
            "additionalProperties": { "type": "string" }
        },
        "fonts": {
            "type": "array",
            "description": "The theme's fonts. Core writes an @font-face for each with face true or absent (family, weight, style, src as the same-origin theme file, font-display swap, optional unicode_range) and preloads at most one. face false means preload only — the theme ships its own @font-face. Each file is relative to the theme's public folder and exists there. A theme that writes every face itself may leave this key out, or keep it for preload with face false.",
            "items": {
                "type": "object",
                "required": ["family", "file"],
                "properties": {
                    "family": { "type": "string", "minLength": 1 },
                    "file": { "type": "string", "minLength": 1 },
                    "weight": {
                        "type": ["string", "integer"],
                        "description": "Any number or text, such as 400 or \"400 700\"."
                    },
                    "style": {
                        "type": "string",
                        "enum": ["normal", "italic", "oblique"]
                    },
                    "preload": {
                        "description": "Only true preloads the font; any other value, or none, does not."
                    },
                    "face": {
                        "type": "boolean",
                        "description": "Whether core writes an @font-face for this font; true when absent. false keeps preload and leaves the face to the theme."
                    },
                    "unicode_range": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Optional unicode-range for the @font-face core writes; omitted when face is false."
                    }
                }
            }
        },
        "tokens": {
            "type": "object",
            "description": "Core design tokens only: base, contrast, accent, on-accent, muted, rule, brand, font-body, font-heading, font-mono, step--1 to step-5, space-1 to space-8. Each value is CSS with no ; { } < or >. base and accent are hex colours. brand is read-only: core writes it from the site's brand colour. For a theme's own names, use custom_tokens.",
            "propertyNames": {
                "enum": [
                    "base",
                    "contrast",
                    "accent",
                    "on-accent",
                    "muted",
                    "rule",
                    "brand",
                    "font-body",
                    "font-heading",
                    "font-mono",
                    "step--1",
                    "step-0",
                    "step-1",
                    "step-2",
                    "step-3",
                    "step-4",
                    "step-5",
                    "space-1",
                    "space-2",
                    "space-3",
                    "space-4",
                    "space-5",
                    "space-6",
                    "space-7",
                    "space-8"
                ]
            },
            "additionalProperties": { "type": "string", "minLength": 1 },
            "properties": {
                "base": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                },
                "accent": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                }
            }
        },
        "tokens_dark": {
            "type": "object",
            "description": "The same core tokens and rules, for the theme's dark scheme. brand is read-only.",
            "propertyNames": {
                "enum": [
                    "base",
                    "contrast",
                    "accent",
                    "on-accent",
                    "muted",
                    "rule",
                    "brand",
                    "font-body",
                    "font-heading",
                    "font-mono",
                    "step--1",
                    "step-0",
                    "step-1",
                    "step-2",
                    "step-3",
                    "step-4",
                    "step-5",
                    "space-1",
                    "space-2",
                    "space-3",
                    "space-4",
                    "space-5",
                    "space-6",
                    "space-7",
                    "space-8"
                ]
            },
            "additionalProperties": { "type": "string", "minLength": 1 },
            "properties": {
                "base": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                },
                "accent": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                }
            }
        },
        "custom_tokens": {
            "type": "object",
            "description": "The theme's own design tokens beyond the core list, written as --teme-<name> after the core tokens. Names are lower-case letters, digits and hyphens, starting with a letter, and must not equal a core token. Values follow the same rule as tokens.",
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]*$"
            },
            "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "custom_tokens_dark": {
            "type": "object",
            "description": "The theme's own dark-scheme tokens, same name and value rules as custom_tokens.",
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]*$"
            },
            "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "styles": {
            "type": "object",
            "description": "Named looks the theme can switch between. Core adds a Style select (fieldset site), defaulting to the first style. Each style may set tokens, tokens_dark, custom_tokens, and fonts (one declared font file to preload). Document and design previews overlay the chosen style on the base tokens ([...base, ...style]) and follow its preload.",
            "propertyNames": {
                "pattern": "^[a-z0-9-]+$"
            },
            "additionalProperties": {
                "type": "object",
                "required": ["label"],
                "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "tokens": { "$ref": "#/properties/tokens" },
                    "tokens_dark": { "$ref": "#/properties/tokens_dark" },
                    "custom_tokens": { "$ref": "#/properties/custom_tokens" },
                    "fonts": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The file of one font declared under fonts; that font is preloaded for this style."
                    }
                }
            }
        },
        "speculation": {
            "type": "boolean",
            "description": "A theme may only opt out: false leaves the prerendering rules out."
        },
        "breadcrumbs": {
            "type": "boolean",
            "description": "Whether the theme draws a breadcrumb trail; false when absent."
        },
        "screenshot": {
            "type": "string",
            "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\\\\\s:]+\\.(?:[pP][nN][gG]|[jJ][pP][gG]|[wW][eE][bB][pP])$",
            "description": "A path inside the theme, with no .., to a .png, .jpg or .webp image, in any case. A missing file is no error."
        },
        "icon": {
            "type": "string",
            "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\\\\\s:]+\\.(?:[pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP]|[sS][vV][gG])$",
            "$comment": "@since 1.3.0",
            "description": "The theme’s icon: a path inside the theme, with no .., to a .png, .jpg, .jpeg, .webp or .svg picture, in any case. Square; drawn at up to 96 pixels. A missing file is no error."
        },
        "site_icon": {
            "type": "string",
            "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\\\\\s:]+\\.(?:[pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP]|[sS][vV][gG])$",
            "$comment": "@since next",
            "description": "The theme’s default favicon: a path inside the theme’s public folder, with no .., to a .png, .jpg, .jpeg, .webp or .svg picture. The design setting site_icon wins over this."
        },
        "screenshots": {
            "type": "array",
            "maxItems": 8,
            "$comment": "@since 1.3.0",
            "description": "Up to 8 pictures of the theme at work, in the order Teme’s directory shows them.",
            "items": {
                "type": "object",
                "required": ["path"],
                "additionalProperties": false,
                "properties": {
                    "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\\\\\s:]+\\.(?:[pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP])$",
                        "description": "A path inside the theme, with no .., to a .png, .jpg, .jpeg or .webp picture, in any case."
                    },
                    "caption": {
                        "type": "string",
                        "maxLength": 140,
                        "description": "What the picture shows, in at most 140 characters."
                    }
                }
            }
        },
        "overrides": {
            "type": "object",
            "description": "Core components the theme replaces with its own view under views/components/, each with the contract number the override was written against (docs/guides/developers/themes/components.md).",
            "propertyNames": { "enum": ["region", "navigation", "languages", "image", "between-items", "comment-form"] },
            "additionalProperties": {
                "type": "object",
                "required": ["contract"],
                "additionalProperties": false,
                "properties": {
                    "contract": { "type": "integer", "minimum": 1, "description": "The contract number the override was written against." }
                }
            }
        },
        "plugin_styles": {
            "type": "object",
            "additionalProperties": false,
            "description": "Plugin stylesheets the theme switches off, so it styles that output itself.",
            "properties": {
                "off": {
                    "type": "array",
                    "maxItems": 100,
                    "description": "Each stylesheet as its plugin's code and output: code:card:<id> or code:insertion:<id>.",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*:(card:[a-z][a-z0-9-]{1,40}|insertion:[a-z][a-z0-9-]{1,40})$"
                    }
                }
            }
        },
        "cards": {
            "type": "object",
            "description": "Cards the theme styles itself, and cards it brings for its own regions.",
            "properties": {
                "replaces": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Registered card names whose core stylesheets the theme replaces with its own."
                },
                "provides": {
                    "type": "object",
                    "maxProperties": 12,
                    "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,40}$" },
                    "description": "Cards the theme brings for its own regions, by id, at most 12. Each is drawn by views/cards/own/{id}.blade.php while the theme is active; its key is code:id, and a region's cards name it by its id.",
                    "additionalProperties": {
                        "type": "object",
                        "required": ["label", "description"],
                        "additionalProperties": false,
                        "properties": {
                            "label": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 40,
                                "description": "The card's name in Add card."
                            },
                            "description": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 160,
                                "description": "One sentence on what the card shows."
                            },
                            "icon": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]{1,40}$",
                                "description": "A Lucide icon's name; a square when it isn't one the editor knows."
                            },
                            "keywords": {
                                "type": "array",
                                "maxItems": 10,
                                "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 40
                                },
                                "description": "Words Add card also finds the card by."
                            },
                            "fields": {
                                "type": "array",
                                "maxItems": 20,
                                "description": "The card's fields, declared as a plugin card's are, without choice.",
                                "items": {
                                    "type": "object",
                                    "required": ["key", "type", "label"],
                                    "properties": {
                                        "key": {
                                            "type": "string",
                                            "pattern": "^[a-z][a-z0-9_]{1,40}$",
                                            "description": "The field's key."
                                        },
                                        "type": {
                                            "enum": [
                                                "text",
                                                "textarea",
                                                "number",
                                                "boolean",
                                                "select",
                                                "multiselect",
                                                "url",
                                                "urls",
                                                "email",
                                                "color",
                                                "person",
                                                "term",
                                                "type"
                                            ]
                                        },
                                        "label": {
                                            "type": "string",
                                            "description": "The name people see."
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "composers": {
            "type": "array",
            "description": "Class names of the theme's view composers, each asking only for Teme\\Contracts interfaces.",
            "items": {
                "type": "string",
                "pattern": "^\\\\?[A-Za-z_][A-Za-z0-9_]*(\\\\[A-Za-z_][A-Za-z0-9_]*)*$"
            }
        },
        "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Items per page of a listing; 10 when absent."
        },
        "csp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "style": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                        "type": "string",
                        "pattern": "^(?:\\*\\.)?(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
                    }
                },
                "font": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                        "type": "string",
                        "pattern": "^(?:\\*\\.)?(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
                    }
                },
                "img": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                        "type": "string",
                        "pattern": "^(?:\\*\\.)?(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
                    }
                },
                "connect": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                        "type": "string",
                        "pattern": "^(?:\\*\\.)?(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
                    }
                },
                "frame": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                        "type": "string",
                        "pattern": "^(?:\\*\\.)?(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
                    }
                },
                "script": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                        "type": "string",
                        "pattern": "^(?:\\*\\.)?(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
                    }
                }
            },
            "description": "Outside hosts the theme's pages load from, by kind. Each is a host name or *.host; https is implied. A theme's own files are always allowed."
        }
    }
}
